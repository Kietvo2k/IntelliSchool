NODE_ENV=development
PORT=3002
HOST=127.0.0.1
ALLOWED_WEB_ORIGINS=http://127.0.0.1:5176,http://127.0.0.1:5177
PUBLIC_DATABASE_URL=postgres://smartpath_public:smartpath_public_local_only@127.0.0.1:5433/smartclass
API_DATABASE_URL=postgres://smartpath_api:smartpath_api_local_only@127.0.0.1:5433/smartclass
PLATFORM_CONTROL_DATABASE_URL=postgres://smartpath_control:smartpath_control_local_only@127.0.0.1:5433/smartclass
PLATFORM_OWNER_EMAIL=owner@example.test
STUDENT_IDENTITY_HMAC_SECRET=replace-with-a-long-random-secret
# Cùng secret dùng cho GET /api/v1/internal/student-records/:studentCode (HMAC nội bộ, không phải gateway công cộng).
# Có thể tách bằng STUDENT_RECORDS_HMAC_SECRET nếu cần.
SUPPORT_ZALO_URL=
SUPPORT_FACEBOOK_URL=
PLATFORM_CRAWL_ALLOWLIST=tuyensinh247.com,vnexpress.net
APP_BASE_URL=http://127.0.0.1:5176
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@smartpath.local
PLATFORM_ADMIN_EMAIL=admin@example.test
PLATFORM_ADMIN_DISPLAY_NAME=Platform Admin
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=smartclass
MINIO_SECRET_KEY=smartclass_local_only
MINIO_QUARANTINE_BUCKET=smartpath-quarantine
MINIO_READY_BUCKET=smartpath-resources
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- Trợ giảng AI / phân tích hướng nghiệp (tùy chọn) ---
# Bỏ trống cũng chạy được local: chat sẽ dùng trả lời TRÍCH XUẤT cục bộ từ tài liệu đã nạp
# (embedding cục bộ tất định, không cần key). Điền key để bật model sinh văn bản thật.
# Key không bao giờ lưu vào DB.
AI_PROVIDER=openai
AI_OPENAI_BASE_URL=https://api.vietapi.tech/v1
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=10000
AI_FALLBACK_MODEL=kimi-k2.6
AI_ANTHROPIC_BASE_URL=https://example.com
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=
AI_EMBEDDING_MODEL=text-embedding-3-small
# Alias cũ (vẫn đọc nếu biến mới trống):
AI_BASE_URL=
AI_API_KEY=

# --- Docker (1 CPU / 1.8GB RAM / 8GB đĩa) ---
COOKIE_SECURE=false
FILE_SIGNING_SECRET=replace-with-a-long-random-secret
FILE_QUOTA_BYTES=6442450944
SEED_ON_EMPTY=true
PG_POOL_MAX=3
RATE_LIMIT_MAX=400

# --- Mã hóa snapshot đề thi ---
# File JSON chứa keyring phải nằm ngoài repo/được mount từ secret manager.
EXAM_SNAPSHOT_KEYRING_FILE=/run/secrets/intellischool-exam-snapshot-keyring.json
EXAM_SNAPSHOT_ACTIVE_KEY_VERSION=v1

# --- Supabase (tùy chọn, điền khi không chạy Postgres local) ---
# Dùng connection TRỰC TIẾP db.<ref>.supabase.co:5432?sslmode=require
# Không dùng transaction pooler. Tạo 3 role bằng database/supabase-bootstrap.sql
# rồi: để COMPOSE_PROFILES trống và
# docker compose -f docker-compose.yml -f docker-compose.supabase.yml up --build -d
DATABASE_BACKEND=local
SUPABASE_PUBLIC_DATABASE_URL=
SUPABASE_API_DATABASE_URL=
SUPABASE_CONTROL_DATABASE_URL=
